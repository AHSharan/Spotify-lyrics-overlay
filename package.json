{
  "name": "electron-spotify-lyrics",
  "version": "1.1.0",
  "description": "Desktop overlay (Electron) showing Spotify now-playing + lyrics (Lyrics.ovh)",
  "main": "main.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "author": "Sharan",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.ahsharan.spotify-lyrics-overlay",
    "productName": "Spotify Lyrics Overlay",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "renderer.html",
      "renderer.js",
      "styles.css",
      "package.json",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
